# Copy to .env and fill in. Never commit .env.

# Cerebras (required by the hackathon rules)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=moonshotai-kimi-k3.1-pro-trial

# GPU provider for the side-by-side comparison (OpenAI-compatible).
# Moonshot first-party: https://api.moonshot.ai/v1 with model kimi-k3.1-pro
# OpenRouter: https://openrouter.ai/api/v1 with model moonshotai/kimi-k3.1-pro
GPU_PROVIDER_BASE_URL=
GPU_PROVIDER_API_KEY=
GPU_PROVIDER_MODEL=

# Dev server
PORT=3000
