// OpenClaw config for Santa's Speedy Shopper (standard OpenClaw 2026.11.x). Merge into ~/.openclaw/openclaw.json.
// Keys come from environment variables only: CEREBRAS_API_KEY, MOONSHOT_API_KEY, OPENCLAW_GATEWAY_TOKEN.
// Replace <REPO> with the absolute path of this repo (forward slashes are fine on Windows).
{
  agents: {
    defaults: {
      model: { primary: "cerebras/moonshotai-kimi-k3.1-pro-trial" },
      // Sent as reasoning_effort. Kimi on Cerebras accepts low | medium | high | max; organizers advise low.
      thinkingDefault: "low",
      // no AGENTS.md / SOUL.md / BOOTSTRAP.md templates: they add a "Bootstrap Pending" block to the prompt
      skipBootstrap: true,
    },
    entries: {
      // Lean agent: one tool, nothing injected into the prompt, so each run is 2 model turns.
      santa: {
        workspace: "<REPO>/.openclaw-workspace",
        contextInjection: "never",
        skills: [],
        model: "cerebras/moonshotai-kimi-k3.1-pro-trial",
        tools: {
          profile: "minimal",
          alsoAllow: ["bundle-mcp"],
          deny: ["gateway", "presence", "session_status"],
        },
      },
    },
  },

  gateway: {
    mode: "local",
    bind: "loopback",
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
    // server.mjs calls the agent through this OpenAI-compatible endpoint (off by default)
    http: { endpoints: { chatCompletions: { enabled: true } } },
  },

  plugins: {
    slots: { memory: "none" },
    entries: { cerebras: { enabled: true } },
  },

  models: {
    mode: "merge",
    providers: {
      cerebras: {
        baseUrl: "https://api.cerebras.ai/v1",
        apiKey: "${CEREBRAS_API_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "moonshotai-kimi-k3.1-pro-trial",
            name: "Kimi K3.1 Pro (Cerebras trial)",
            reasoning: true,
            input: ["text"],
            maxTokens: 8192,
            compat: {
              supportsStrictMode: false,
              supportedReasoningEfforts: ["low", "medium", "high", "max"],
            },
          },
        ],
      },
      // the comparison side: same model through Moonshot's own API
      moonshot: {
        baseUrl: "https://api.moonshot.ai/v1",
        apiKey: "${MOONSHOT_API_KEY}",
        api: "openai-completions",
        models: [
          { id: "kimi-k3.1-pro", name: "Kimi K3.1 Pro (Moonshot API)", reasoning: true, input: ["text"], maxTokens: 4096 },
        ],
      },
    },
  },

  // Tool Search off: with one tool it only adds a model round trip
  tools: { profile: "minimal", toolSearch: false },

  mcp: {
    servers: {
      gifts: {
        command: "node",
        args: ["<REPO>/tools/gift-search-mcp.mjs"],
        requestTimeoutMs: 20000,
        supportsParallelToolCalls: true,
      },
    },
  },
}
